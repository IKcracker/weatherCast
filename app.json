{
  "expo": {
    "name": "weatherCast",
    "slug": "weatherCast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/light-logo.png",
    "scheme": ".",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
       ["expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(weatherCast) to use your location."
        }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}